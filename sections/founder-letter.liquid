

<div
  class="founder-letter"
  style="
    --founder-accent: {{ section.settings.accent_color }};
    background: {{ section.settings.background_color }};
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="founder-letter__container">
    <div class="founder-letter__grid">
      <div class="founder-letter__media">
        <div class="founder-letter__portrait founder-letter__portrait--tall">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                class: 'founder-letter__portrait-image',
                alt: section.settings.founder_name,
                loading: 'lazy'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'founder-letter__portrait-image founder-letter__portrait-image--placeholder' }}
          {%- endif -%}
        </div>
      </div>

      <div class="founder-letter__content">
        {%- if section.settings.pullquote != blank -%}
          <p class="founder-letter__pullquote">{{ section.settings.pullquote }}</p>
        {%- endif -%}

        {%- if section.settings.short_quote != blank -%}
          <blockquote class="founder-letter__quote">{{ section.settings.short_quote }}</blockquote>
        {%- endif -%}

        {%- if section.settings.body_1 != blank -%}
          <div class="founder-letter__body">{{ section.settings.body_1 }}</div>
        {%- endif -%}

        {%- if section.settings.body_2 != blank -%}
          <div class="founder-letter__body">{{ section.settings.body_2 }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .founder-letter__container {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 48px);
  }

  .founder-letter__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }

  .founder-letter__media {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.5vw, 20px);
  }

  .founder-letter__portrait {
    position: relative;
    overflow: hidden;
  }

  .founder-letter__portrait--tall {
    aspect-ratio: 4 / 5;
    width: 65%;
    margin-inline: auto;
    border-radius: 10px;
    box-shadow: 0 18px 40px rgb(var(--color-foreground-rgb) / 0.12);
  }

  .founder-letter__portrait-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .founder-letter__portrait-image--placeholder {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .founder-letter__content {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    padding-block-start: clamp(8px, 1.5vw, 16px);
  }

  .founder-letter__pullquote {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(1.25rem, 1rem + 1.4vw, 1.875rem);
    line-height: 1.3;
    color: var(--color-foreground);
  }

  .founder-letter__quote {
    margin: 0;
    padding-inline-start: 1.25rem;
    border-inline-start: 3px solid var(--founder-accent, #B98B4E);
    font-family: var(--font-body--family);
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .founder-letter__body {
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: rgb(var(--color-foreground-rgb) / 0.85);
  }

  .founder-letter__body p {
    margin: 0 0 1em;
  }

  .founder-letter__body p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .founder-letter__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Founder letter",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder portrait"
    },
    {
      "type": "header",
      "content": "Story"
    },
    {
      "type": "text",
      "id": "pullquote",
      "label": "Pull-quote headline",
      "default": "Every stitch we choose is a quiet promise: comfort should never be compromised."
    },
    {
      "type": "text",
      "id": "short_quote",
      "label": "Short accent quote",
      "default": "I didn't set out to build a fashion brand. I set out to build a bedtime ritual worth keeping."
    },
    {
      "type": "richtext",
      "id": "body_1",
      "label": "Body paragraph 1",
      "default": "<p>Néroli began with a simple frustration: sleepwear that looked beautiful in photos but felt like a compromise in real life. Scratchy seams, synthetic fabric, fits that never quite matched the body they were meant for.</p>"
    },
    {
      "type": "richtext",
      "id": "body_2",
      "label": "Body paragraph 2",
      "default": "<p>So we started over — sourcing real, breathable fabric, fitting each piece on real bodies, and refusing to rush a single sample. What you're wearing tonight is the result of that stubbornness, and we hope you can feel it.</p>"
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder name (used for photo alt text)",
      "default": "Noa Amrani"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (quote border, badge)",
      "default": "#B98B4E"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FBF7F2"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Founder letter",
      "category": "Storytelling"
    }
  ]
}
{% endschema %}
