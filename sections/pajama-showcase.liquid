

{% liquid
  assign placeholder_names = 'apparel-1,apparel-2,apparel-3,apparel-4' | split: ','
%}

<div
  class="pajama-showcase"
  style="
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="pajama-showcase__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="pajama-showcase__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="pajama-showcase__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign placeholder_index = forloop.index0 | modulo: 4
          assign placeholder_name = placeholder_names[placeholder_index]
        -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="pajama-showcase__tile"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                class: 'pajama-showcase__image',
                alt: block.settings.name,
                loading: 'lazy'
            }}
          {%- else -%}
            {{ placeholder_name | placeholder_svg_tag: 'pajama-showcase__image pajama-showcase__image--placeholder' }}
          {%- endif -%}
          <span class="pajama-showcase__scrim"></span>
          {%- if block.settings.name != blank -%}
            <span class="pajama-showcase__name">{{ block.settings.name }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pajama-showcase {
    background: var(--color-background);
  }

  .pajama-showcase__container {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 48px);
  }

  .pajama-showcase__heading {
    margin: 0 0 clamp(24px, 3vw, 40px);
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.5rem);
    text-align: center;
    color: var(--color-foreground);
  }

  .pajama-showcase__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 1.5vw, 24px);
  }

  .pajama-showcase__tile {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    text-decoration: none;
  }

  .pajama-showcase__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .pajama-showcase__image--placeholder {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .pajama-showcase__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.35), rgb(0 0 0 / 0) 45%);
    pointer-events: none;
  }

  .pajama-showcase__name {
    position: absolute;
    left: 50%;
    bottom: clamp(16px, 3vw, 28px);
    transform: translateX(-50%);
    max-width: 90%;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.375rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #ffffff;
    text-align: center;
    text-wrap: balance;
  }

  @media screen and (max-width: 989px) {
    .pajama-showcase__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pajama showcase",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This Season's Favorites"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Pajama tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Pajama Set"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pajama showcase",
      "category": "Product",
      "blocks": [
        { "type": "tile", "settings": { "name": "Moonlight Set" } },
        { "type": "tile", "settings": { "name": "Linen Drift" } },
        { "type": "tile", "settings": { "name": "Cloud Nine" } },
        { "type": "tile", "settings": { "name": "Sable Stripe" } },
        { "type": "tile", "settings": { "name": "Dawn Robe" } },
        { "type": "tile", "settings": { "name": "Blush Bloom" } },
        { "type": "tile", "settings": { "name": "Ivory Rest" } }
      ]
    }
  ]
}
{% endschema %}
